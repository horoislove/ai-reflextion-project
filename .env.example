# Скопируй этот файл в .env и заполни значения.

# Токен Telegram-бота (получить у @BotFather)
TG_BOT_TOKEN=

# Ollama
OLLAMA_URL=http://localhost:11434/api/chat
# Имя модели в Ollama. Сначала выполни: ollama pull <модель>
# Для русскоязычного эмпатичного диалога неплохие кандидаты:
#   qwen2.5:7b-instruct, gemma2:9b, llama3.1:8b-instruct-q4_K_M
OLLAMA_MODEL=qwen2.5:7b-instruct

# URL бэкенда, к которому обращается бот
BACKEND_URL=http://localhost:8000/chat

# Сколько последних сообщений держать в контексте (скользящее окно)
HISTORY_WINDOW=20